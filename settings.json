{
    // ============================================================================
    // VS Code Settings — Dracula theme replica (no extension required)
    // Path: profiles/1afb8a31/settings.json
    //
    // How to tweak:
    //   - Change any hex color (e.g. "#ff79c6" = pink) to another in the palette:
    //       bg       #282a36   current  #44475a   fg       #f8f8f2
    //       comment  #6272a4   cyan     #8be9fd   green    #50fa7b
    //       orange   #ffb86c   pink     #ff79c6   purple   #bd93f9
    //       red      #ff5555   yellow   #f1fa8c
    //     (alpha = add 2 hex digits, e.g. "#ff79c655" = ~33% pink)
    //   - After editing: Ctrl+Shift+P → "Reload Window"
    // ============================================================================

    // ---------------------------------------------------------------------------
    // SECTION 1: Window & global editor behavior
    // ---------------------------------------------------------------------------
    "window.zoomLevel": 3,

    // Bracket pair colorization — colors each () [] {} pair differently.
    "editor.bracketPairColorization.enabled": true,
    "editor.bracketPairColorization.independentColorPoolPerBracketType": false,

    // Indentation + bracket guides drawn in the editor gutter area.
    "editor.guides.bracketPairs": "active",            // only highlight the pair under cursor
    "editor.guides.bracketPairsHorizontal": "active",  // horizontal bracket pairs too
    "editor.guides.indentation": true,                  // draw vertical indent lines
    "editor.guides.highlightActiveIndentation": true,   // brighten the active indent level

    // Semantic tokens (TS / Python / Rust) get type-aware coloring.
    "editor.semanticHighlighting.enabled": true,

    // Caret animation — smooth phase glow matching Dracula's polished look.
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorBlinking": "phase",

    // Only show whitespace dots inside a selection (cleaner reading otherwise).
    "editor.renderWhitespace": "selection",

    // Minimap shows colored blocks instead of tiny characters.
    "editor.minimap.renderCharacters": false,

    // Font — fallback chain: JetBrains Mono → Fira Code → Cascadia → Consolas.
    // Install any one of these for best result; otherwise Consolas is used.
    "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', Consolas, 'Courier New', monospace",
    "editor.fontLigatures": true,    // turns => into arrows etc. (needs a ligature font)
    "editor.fontSize": 14,
    "editor.lineHeight": 19,

    // Terminal font synced to the editor font.
    "terminal.integrated.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace",
    "terminal.integrated.fontSize": 14,

    // File icon theme — vs-seti is built into VS Code (no extension needed).
    "workbench.iconTheme": "vs-seti",

    // Base theme onto which we overlay Dracula colors.
    "workbench.colorTheme": "Dark+",

    // ---------------------------------------------------------------------------
    // SECTION 2: workbench.colorCustomizations — the ENTIRE UI chrome
    // Override any of these to change buttons, panels, sidebars, etc.
    // ---------------------------------------------------------------------------
