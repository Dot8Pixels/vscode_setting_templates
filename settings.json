    // ---------------------------------------------------------------------------
    // SECTION 3: editor.tokenColorCustomizations — SYNTAX highlighting
    // Each rule maps a TextMate scope to a foreground color (and optional fontStyle).
    // To override Dracula colors for a specific token type, change the hex here.
    // ---------------------------------------------------------------------------
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            // ----- Comments -----
            { "scope": "comment", "settings": { "foreground": "#6272a4", "fontStyle": "italic" } },
            { "scope": "comment.block.documentation", "settings": { "foreground": "#6272a4" } },

            // ----- Strings -----
            { "scope": "string", "settings": { "foreground": "#f1fa8c" } },
            { "scope": "string.regexp", "settings": { "foreground": "#f1fa8c" } },
            { "scope": "string.interpolated", "settings": { "foreground": "#f1fa8c" } },
            { "scope": "string.quoted", "settings": { "foreground": "#f1fa8c" } },

            // ----- Constants -----
            { "scope": "constant.numeric", "settings": { "foreground": "#bd93f9" } },     // numbers
            { "scope": "constant.language", "settings": { "foreground": "#bd93f9" } },    // true/false/null
            { "scope": "constant.character", "settings": { "foreground": "#bd93f9" } },
            { "scope": "constant.character.escape", "settings": { "foreground": "#ff79c6" } }, // \n, \t

            // ----- Keywords -----
            { "scope": "keyword", "settings": { "foreground": "#ff79c6", "fontStyle": "italic" } },
            { "scope": "keyword.control", "settings": { "foreground": "#ff79c6", "fontStyle": "italic" } }, // if/else/for
            { "scope": "keyword.operator", "settings": { "foreground": "#ff79c6" } },
            { "scope": "keyword.control.import", "settings": { "foreground": "#ff79c6" } }, // import/from

            // ----- Storage (var/let/const type modifiers) -----
            { "scope": "storage", "settings": { "foreground": "#ff79c6", "fontStyle": "italic" } },
            { "scope": "storage.type", "settings": { "foreground": "#8be9fd", "fontStyle": "italic" } },     // int, string
            { "scope": "storage.modifier", "settings": { "foreground": "#ff79c6", "fontStyle": "italic" } }, // static, public

            // ----- Entities (functions, types, tags) -----
            { "scope": "entity.name.function", "settings": { "foreground": "#50fa7b" } },     // function names
            { "scope": "entity.name.type", "settings": { "foreground": "#8be9fd" } },        // type names
            { "scope": "entity.name.class", "settings": { "foreground": "#8be9fd" } },
            { "scope": "entity.name.function.preprocessor", "settings": { "foreground": "#ff79c6" } },
            { "scope": "entity.name.section", "settings": { "foreground": "#bd93f9" } },     // markdown headings
            { "scope": "entity.name.tag", "settings": { "foreground": "#ff79c6" } },         // HTML tags
            { "scope": "entity.other.attribute-name", "settings": { "foreground": "#50fa7b" } }, // HTML attributes
            { "scope": "entity.other.inherited-class", "settings": { "foreground": "#8be9fd", "fontStyle": "italic" } },

            // ----- Variables -----
            { "scope": "variable", "settings": { "foreground": "#f8f8f2" } },
            { "scope": "variable.parameter", "settings": { "foreground": "#ffb86c", "fontStyle": "italic" } }, // fn params
            { "scope": "variable.language", "settings": { "foreground": "#bd93f9", "fontStyle": "italic" } }, // this/self
            { "scope": "variable.other", "settings": { "foreground": "#f8f8f2" } },

            // ----- Support (built-in library stuff) -----
            { "scope": "support.function", "settings": { "foreground": "#8be9fd" } },  // console.log
            { "scope": "support.class", "settings": { "foreground": "#8be9fd" } },
            { "scope": "support.type", "settings": { "foreground": "#8be9fd" } },
            { "scope": "support.constant", "settings": { "foreground": "#bd93f9" } },
            { "scope": "support.variable", "settings": { "foreground": "#50fa7b" } },

            // ----- Punctuation -----
            { "scope": "punctuation.definition.string", "settings": { "foreground": "#f1fa8c" } },
            { "scope": "punctuation.definition.comment", "settings": { "foreground": "#6272a4" } },
            { "scope": "punctuation.separator", "settings": { "foreground": "#f8f8f2" } },
            { "scope": "punctuation.terminator", "settings": { "foreground": "#f8f8f2" } },

            // ----- Meta -----
            { "scope": "meta.function-call", "settings": { "foreground": "#50fa7b" } },
            { "scope": "meta.preprocessor", "settings": { "foreground": "#ff79c6" } },
            { "scope": "meta.tag", "settings": { "foreground": "#f8f8f2" } },

            // ----- Markup (markdown / restructuredtext) -----
            { "scope": "markup.heading", "settings": { "foreground": "#bd93f9", "fontStyle": "bold" } },
            { "scope": "markup.bold", "settings": { "foreground": "#ff79c6", "fontStyle": "bold" } },
            { "scope": "markup.italic", "settings": { "foreground": "#ff79c6", "fontStyle": "italic" } },
            { "scope": "markup.underline", "settings": { "foreground": "#ffb86c" } },

            // ----- Diff markup -----
            { "scope": "markup.inserted", "settings": { "foreground": "#50fa7b" } },
            { "scope": "markup.deleted", "settings": { "foreground": "#ff5555" } },
            { "scope": "markup.changed", "settings": { "foreground": "#ffb86c" } },
            { "scope": "markup.raw", "settings": { "foreground": "#f1fa8c" } },
            { "scope": "markup.quote", "settings": { "foreground": "#6272a4", "fontStyle": "italic" } },

            // ----- Markdown links -----
            { "scope": "markdown:link", "settings": { "foreground": "#8be9fd" } },

            // ----- JSON -----
            { "scope": "source.json", "settings": { "foreground": "#f8f8f2" } },
            { "scope": "source.json support.type.property-name", "settings": { "foreground": "#8be9fd" } },

            // ----- CSS -----
            { "scope": "source.css", "settings": { "foreground": "#f8f8f2" } },
            { "scope": "source.css entity.other", "settings": { "foreground": "#ff79c6" } },
            { "scope": "source.css support", "settings": { "foreground": "#8be9fd" } }
        ]
    }
}